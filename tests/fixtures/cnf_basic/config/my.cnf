# MySQL option file: bare flags, quotes, escapes, repeated groups
[client]
port		= 3306
socket		= /var/run/mysqld/mysqld.sock
password	= "pa ss#word"   # quoted: the space and # are kept

[mysqld]
user = mysql
skip-networking
skip-external-locking   # a flag with a trailing comment
basedir = C:\Program Files\MySQL
init-connect = 'SET NAMES utf8mb4'
plugin-load-add=auth_socket.so
sql_mode = STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION
ft_stopword_file = a\sb\tc
log-error =
port = 3306
port = 3307
; a semicolon comment

[mysqldump]
quick
max_allowed_packet = 16M

[mysqld]
bind-address = 127.0.0.1

!includedir /etc/mysql/conf.d/
!include /etc/mysql/secret.cnf
